# Copy to .env.development.local and fill in. .env.*.local is gitignored.

APP_ENV=development
PORT=8080
LOG_LEVEL=info

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ps188

# Auth — generate long random strings for production
JWT_SECRET=change-me-dev-secret
JWT_REFRESH_SECRET=change-me-dev-refresh-secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=720h

# CORS (comma-separated, or * for any)
CORS_ALLOW_ORIGINS=*

# Uploads
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_PER_MIN=300

# First-run bootstrap super admin (seeded only when the users collection is empty).
# Legacy ADMIN_* names are still read as a fallback.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=admin12345
SUPERADMIN_EMAIL=admin@ps188.local

# External Python/FastAPI screening model (passport-model/server.py)
#   SCREENING_ENGINE=http  -> calls SCREENING_SERVICE_URL/api/v1/verify
#   SCREENING_ENGINE=mock  -> deterministic offline stub (no network)
SCREENING_ENGINE=http
SCREENING_SERVICE_URL=https://passport-model.onrender.com
SCREENING_SERVICE_API_KEY=midv2020-secret-api-key-2026
SCREENING_SERVICE_TIMEOUT=60s
