# Copy to .env.development.local and fill in. .env.*.local is gitignored.

APP_ENV=development
PORT=8080
LOG_LEVEL=info

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ps188

# Auth — generate long random strings for production
JWT_SECRET=change-me-dev-secret
JWT_REFRESH_SECRET=change-me-dev-refresh-secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=720h

# CORS (comma-separated, or * for any)
CORS_ALLOW_ORIGINS=*

# Uploads
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_PER_MIN=300

# First-run bootstrap super admin (seeded only when the users collection is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_EMAIL=admin@ps188.local

# External Python/FastAPI screening model
#   SCREENING_ENGINE=http  -> calls SCREENING_SERVICE_URL
#   SCREENING_ENGINE=mock  -> deterministic offline stub (no network)
SCREENING_ENGINE=mock
SCREENING_SERVICE_URL=
SCREENING_SERVICE_API_KEY=
SCREENING_SERVICE_TIMEOUT=30s
